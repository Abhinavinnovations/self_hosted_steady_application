# Single root environment file (local dev). On Render, set these as service env vars instead.
# Never commit real credentials.
NODE_ENV=development
# Public HTTPS origin of the backend, e.g. https://steady-api.onrender.com (no trailing slash)
WEBSITE_URL=
# Must match expo.scheme in packages/mobile/app.json
APP_SCHEME=steady
# Mobile fallback only: expo.extra.apiUrl / STEADY_API_URL take precedence. No secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=

# Better Auth. Reuse your existing value if you have one (sessions + stored invitation payloads depend on it).
BETTER_AUTH_SECRET=
# Optional privileged SQL console at /admin. Blank means console access is refused.
ADMIN_KEY=
# Secret for GET /api/cron/tick?key=... (keep-alive + missed-day sweep)
CRON_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Google sign-in (Google Cloud Console -> OAuth client ID -> Web application)
# Authorized redirect URI: <WEBSITE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Voice-to-task: Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Alternative: an AI gateway (used only when GEMINI_API_KEY is blank)
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Server-only transactional email.
# gmail + GMAIL_TRANSPORT=apps_script -> HTTPS relay (works on Render free, which blocks SMTP)
# gmail + GMAIL_TRANSPORT=smtp        -> smtp.gmail.com with an App Password
# resend                              -> verified-domain sender
EMAIL_PROVIDER=gmail
GMAIL_TRANSPORT=apps_script
GMAIL_USER=
EMAIL_FROM=
GMAIL_RELAY_URL=
GMAIL_RELAY_SECRET=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=

# Accountability features (migrations in packages/web/migrations must already be applied)
INVITATION_DELIVERY_ENABLED=false
RECIPIENT_FLOW_ENABLED=false
# Public HTTPS web/API origin with exact /invitation path (not mobile /profile).
INVITATION_APP_URL=
MISS_ALERTS_ENABLED=false
MISS_ALERTS_START_DATE=
