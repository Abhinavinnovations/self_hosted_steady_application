{
  "expo": {
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.abhinavinnovations.steady",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#101316"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "extra": {
      "apiUrl": "https://steady-api.onrender.com"
    },
    "ios": {
      "bundleIdentifier": "com.abhinavinnovations.steady",
      "supportsTablet": true
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#101316"
    },
    "name": "Steady",
    "slug": "steady",
    "version": "1.0.0",
    "scheme": "steady",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      "expo-audio",
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Steady to hear the tasks you choose to dictate.",
          "speechRecognitionPermission": "Allow Steady to show words as you speak. Your speech service may process audio online."
        }
      ],
      "./plugins/with-release-signing"
    ]
  }
}
